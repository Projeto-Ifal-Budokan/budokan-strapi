# Copie para .env e preencha. .env está no .gitignore — nunca commitar valores reais.
# Gerar segredos (mesmo gerador usado por deploy.sh):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"   # JWT_SECRET, ADMIN_JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # API_TOKEN_SALT, TRANSFER_TOKEN_SALT, REDIS_PASSWORD
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))" # cada APP_KEY
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))" # ENCRYPTION_KEY (32 chars)

HOST=0.0.0.0
PORT=1337

# Database
DATABASE_CLIENT=mysql
DATABASE_HOST=strapi-mysql
DATABASE_PORT=3306
DATABASE_NAME=budokan-cms
DATABASE_USERNAME=budokan
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false
# Usado apenas pelo container do MySQL
MYSQL_ROOT_PASSWORD=tobemodified

# Cache/sessões (container redis)
REDIS_PASSWORD=tobemodified

# Segredos da aplicação
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# URL pública deste ambiente
STRAPI_URL=http://localhost:1337

# --- feedback do site ---
# Chave que autoriza o envio de depoimento. O servidor do Next manda no cabecalho
# X-Feedback-Key; sem ela o endpoint recusa tudo (fail closed). Gere com:
#   openssl rand -hex 24
FEEDBACK_SUBMIT_KEY=
